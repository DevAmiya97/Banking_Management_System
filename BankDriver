package BankManagementSystem;

import java.sql.DriverManager;
import java.sql.SQLException;
import java.util.Scanner;
import java.sql.Connection;

public class BankDriver {

	 private static final String url = "jdbc:postgresql://localhost:5432/myBankingDb";
	    private static final String username = "postgres";
	    private static final String password = "root";

	    public static void main(String[] args) throws ClassNotFoundException, SQLException { 
	        try{
	            Class.forName("org.postgresql.Driver");
	            
	        }
	        catch (ClassNotFoundException e){
	        	
	            System.out.println(e.getMessage());
	        }
	        try{
	            Connection connection = DriverManager.getConnection(url, username, password);
	            Scanner scanner =  new Scanner(System.in);
	            User user = new User(connection, scanner);
	            Accounts accounts = new Accounts(connection, scanner); 
	            TransactionHistory transactionHistory =  new TransactionHistory(connection);
	            AccountManager accountManager = new AccountManager(connection, scanner,transactionHistory);

	            String phone_number; 
	            long account_number;
	            
	            while(true){
	                System.out.println("*** WELCOME TO OUR BANKING SYSTEM ***");
	                System.out.println();
	                System.out.println("1. Register");
	                System.out.println("2. Login");
	                System.out.println("3. Exit");
	                System.out.println("Enter your choice: ");
	                int choice1 = scanner.nextInt();
	                switch (choice1){
                    case 1:
                        user.register();
                        break;
                    case 2:
                        phone_number = user.login(); 
                        if(phone_number!=null){
                            System.out.println();
                            System.out.println("User Logged In Successfully...");
                            if(!accounts.account_exist(phone_number)){
                                System.out.println();
                                System.out.println("1. Open a new Bank Account");
                                System.out.println("2. Exit");
                                if(scanner.nextInt() == 1) {
                                    account_number = accounts.open_account(phone_number);
                                    System.out.println("Account Created Successfully");
                                    System.out.println("Your Account Number is: " + account_number);
                                }else{
                                    break;
                                }

                            }
                            account_number = accounts.getAccount_number(phone_number);
                            int choice2 = 0;
                            while (choice2 != 6) {
                                System.out.println();
                                System.out.println("1. Debit Money");
                                System.out.println("2. Credit Money");
                                System.out.println("3. Transfer Money");
                                System.out.println("4. Check Balance");
                                System.out.println("5.  Transaction History");
                                System.out.println("6.  Log Out");
                                System.out.println("Enter your choice: ");
                                choice2 = scanner.nextInt();
                                switch (choice2) {
                                    case 1:
                                        accountManager.debit_money(account_number);
                                        break;
                                    case 2:
                                        accountManager.credit_Money(account_number);
                                        break;
                                    case 3:
                                        accountManager.transfer_money(account_number);
                                        break;
                                    case 4:
                                        accountManager.getBalance(account_number);
                                        break;
                                    case 5:
                                    	transactionHistory.showTransactionHistory(account_number);
                                        break;
                                    case 6:
                                        System.out.println("Logged Out Successfully");
                                        break;  
                                    default:
                                        System.out.println("Enter Valid Choice And Try Again ..");
                                        break;
                                }
                            }

                        }
                        else{
                            System.out.println("Incorrect Phone Number or Password ");
                        }
                        break;
                    case 3:
                        System.out.println("THANK YOU FOR USING BANKING SYSTEM VISIT AGAIN 🙏🙏");
                    
                        return;
                    default:
                        System.out.println("Enter Valid Choice");
                        break;
                }
            }
        } catch (SQLException e){
            e.printStackTrace();
        }
    }

}

